# Public Vite env vars only (no secrets).
# Optional absolute API origin for production builds (leave empty in local
# dev so the browser uses same-origin /api via the Vite proxy).
# VITE_API_BASE_URL=

# Vite same-origin proxy targets (dev server only).
# Defaults: /api → http://127.0.0.1:8090
#           /models and other media → https://localhost:5080
# When API and media share one host, set both to that origin.
VITE_API_PROXY=http://127.0.0.1:8090
VITE_MEDIA_PROXY=https://localhost:5080

# Dev listen address (default 0.0.0.0 so phones can use https://<lan-ip>:5173).
# Set to localhost to bind loopback only.
# VITE_DEV_HOST=0.0.0.0
