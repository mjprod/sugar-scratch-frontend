# Public Vite env vars only (no secrets).
# Optional absolute API origin for production builds (leave empty in local
# dev so the browser uses same-origin /api via the Vite proxy).
# VITE_API_BASE_URL=

# Stub Google/Apple login (also set ALLOW_STUB_OAUTH=1 on the API).
# VITE_STUB_OAUTH=1

# Real Google login: OAuth Web client ID (public). The API needs the same ID
# plus GOOGLE_CLIENT_SECRET. Add this dev origin under "Authorized JavaScript
# origins" in Google Cloud Console (bare LAN IPs are rejected by Google).
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Real Apple login: Sign in with Apple Services ID (public). The API needs the
# same value as APPLE_CLIENT_ID. Apple only accepts registered HTTPS domains
# (no localhost / LAN IPs): add this site's domain and the exact return URL
# below to the Services ID. The return URL defaults to the page origin.
# VITE_APPLE_CLIENT_ID=com.example.sugar.web
# VITE_APPLE_REDIRECT_URI=https://play.example.com

# Lab routes (/component-lab, /audio-test, /game-ui, /coverflow-v2,
# /mobile-carousel, /pre-loader) are dev-only; set to 1 to ship them in a build.
# VITE_ENABLE_LABS=1

# Vite same-origin proxy targets (dev server only).
# Defaults: /api → http://127.0.0.1:8090
#           /models and other media → https://localhost:5080
# When API and media share one host, set both to that origin.
VITE_API_PROXY=http://127.0.0.1:8090
VITE_MEDIA_PROXY=https://localhost:5080

# --- Mobile on same Wi‑Fi ---
# 1) npm run certs          # once (needs mkcert)
# 2) npm run dev            # listens on 0.0.0.0:5173 (+ HTTPS if .certs/)
# 3) On phone open https://<your-lan-ip>:5173
#    (Vite prints Network URLs on start)
# Dev listen address (default 0.0.0.0). Set to localhost to bind loopback only.
# VITE_DEV_HOST=0.0.0.0
